# Discord Bot Configuration
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Environment Configuration
# LOG_LEVEL options: error, warn, info, debug, verbose, silly
NODE_ENV=development
LOG_LEVEL=info
# Set to 'false' in production containers to only log to stdout
LOG_TO_FILE=true
LOG_FILE=bot.log

# Audio Configuration
MAX_QUEUE_SIZE=50
EXTRACTION_TIMEOUT=30000
INACTIVITY_TIMEOUT=300000
FFMPEG_ACTIVITY_CHECK_INTERVAL=10000
FFMPEG_INACTIVE_WARNING_THRESHOLD=30000
FFMPEG_INACTIVE_KILL_THRESHOLD=60000
ENABLE_UNLIMITED_LENGTH=true

# Retry / CDN failure handling
# Bilibili's risk-control layer locks a signed URL for ~30s after a 403, so
# a fixed short retry just re-hits the same locked URL. Use exponential
# backoff to give the lock time to release: attempt N waits
# base * multiplier^(N-1), capped at max.
# Defaults produce: 3s → 15s → 30s (hard capped).
RETRY_CDN_BACKOFF_BASE_MS=3000
RETRY_CDN_BACKOFF_MULTIPLIER=5
RETRY_CDN_BACKOFF_MAX_MS=30000

# Bilibili Configuration
# Path to Netscape-format cookies file for Bilibili authentication
# Required when running on cloud servers (fixes HTTP 412 Precondition Failed)
# Export from browser using "Get cookies.txt LOCALLY" extension
BILIBILI_COOKIES_FILE=/app/cookies.txt

# Observability
# METRICS_ENABLED=true turns on the /metrics + /healthz HTTP server.
# In docker, you also need METRICS_HOST=0.0.0.0 so the in-container
# server accepts the forwarded traffic from host loopback
# (docker-compose publishes "127.0.0.1:9090:9090"). On bare metal leave
# unset (defaults to 127.0.0.1).
METRICS_ENABLED=false
# METRICS_HOST=0.0.0.0
# METRICS_PORT=9090

# Phase 1 Shadow Mode
# When true, the new TypeScript state machine runs alongside the legacy
# AudioPlayer and logs any prediction divergences. Requires dist/ to be
# compiled (`npm run build`, or the Dockerfile builder stage). Safe to
# leave false in production; the bridge returns a no-op stub when unset.
SHADOW_MODE_ENABLED=false

# Test Configuration
TEST_MODE=false
TEST_GUILD_ID=

