{
  "name": "bilibili-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for streaming Bilibili video audio",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "tools": "node scripts/tools/bot-tools.js",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:build": "bash scripts/deploy/build.sh",
    "deploy": "bash scripts/deploy/release.sh",
    "deploy:commands": "node scripts/deploy-commands.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "pretest": "eslint src/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:system": "node tests/utils/test-runner-fixed.js system",
    "test:playback": "node tests/utils/test-runner-fixed.js playback",
    "test:ci": "CI_SMOKE=1 npm run lint && CI_SMOKE=1 npm run test:system",
    "prepare": "husky"
  },
  "keywords": [
    "discord",
    "bot",
    "bilibili",
    "audio",
    "music"
  ],
  "author": "Individual Developer",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.9",
    "axios": "^1.6.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "opusscript": "^0.0.8",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.4.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.0.2",
    "standard": "^17.1.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "src/**/*.js": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/bilibili-discord-bot.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/bilibili-discord-bot/issues"
  },
  "homepage": "https://github.com/yourusername/bilibili-discord-bot#readme"
}
